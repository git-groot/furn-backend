# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Neon PostgreSQL Database Configuration (Serverless)
# Neon Pooled connection string (used by application pool at runtime)
DATABASE_URL=postgresql://neondb_owner:npg_fakePassword123@ep-example-pooler.us-east-2.aws.neon.tech/myfurniture_db?sslmode=require

# Neon Direct Unpooled connection string (used for migrations and seeding; optional, falls back to DATABASE_URL if empty)
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:npg_fakePassword123@ep-example.us-east-2.aws.neon.tech/myfurniture_db?sslmode=require

# Optional separate branch/database connection string for running test suites
# TEST_DATABASE_URL=postgresql://neondb_owner:npg_fakePassword123@ep-test-pooler.us-east-2.aws.neon.tech/myfurniture_test_db?sslmode=require

# Migration execution on server start (defaults to true in development, false in production)
RUN_MIGRATIONS_ON_START=true

# Initial Administrator Seed Credentials (development only)
ADMIN_EMAIL=admin@myfurniture.com
ADMIN_PASSWORD=Admin@123456

# Security & JWT Secrets
JWT_ACCESS_SECRET=super_secret_access_token_key_change_in_production_32chars
JWT_REFRESH_SECRET=super_secret_refresh_token_key_change_in_production_32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Logging
LOG_LEVEL=info
